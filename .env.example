# Copy this file to .env and fill in real values. NEVER commit .env.

# --- Database (Neon / any PostgreSQL 14+) ---
# Format: postgresql+psycopg2://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Local PostgreSQL example: postgresql+psycopg2://postgres:your_password@localhost:5432/cricbuzz_livestats
DATABASE_URL=postgresql+psycopg2://USER:your_password@HOST/DBNAME?sslmode=require

# --- Cricbuzz API (RapidAPI) ---
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=cricbuzz-cricket.p.rapidapi.com
API_TIMEOUT=15

# --- App ---
ADMIN_PASSWORD=change_me
CACHE_TTL_LIVE=60
CACHE_TTL_STATS=3600
LOG_LEVEL=INFO
